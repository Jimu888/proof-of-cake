# 当前仅支持演示模式；切勿填写私钥或助记词。
APP_MODE=demo
# 服务端分成配置，修改时同时递增版本。5000 表示艺术家 50%。
ARTIST_REVENUE_BPS=5000
REVENUE_SPLIT_VERSION=split-v1

# 钱包登录使用当前本机地址。远程测试时填写与浏览器一致的 HTTPS origin。
# MEMENT_ORIGIN=https://test.example.com
# 从 Reown 获取，用于 WalletConnect 扫码。
WALLETCONNECT_PROJECT_ID=
# 只填 BNB Smart Chain 测试网部署的赠礼合约地址。
MEMENT_TESTNET_CONTRACT=

# 可选，本地可写持久目录，默认 delivery/platform-demo。
# MEMENT_DATA_DIR=/absolute/path/to/mement-data
# 可选，运营登录密钥。留空时程序在本地数据目录按需生成 operator.key。
# MEMENT_OPERATOR_KEY=
# 本地隔离链验收专用，必须为链 97 的 loopback 地址。
# MEMENT_LOCAL_TESTNET_RPC=http://127.0.0.1:8545
