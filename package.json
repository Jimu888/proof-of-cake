{
  "name": "proof-of-cake",
  "version": "0.1.0",
  "private": true,
  "description": "Curated onchain birthday gifts — project foundation",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:birthday": "node scripts/build-birthday-demo.mjs",
    "compile:nft": "node scripts/birthday-nft-compile.mjs",
    "test:nft": "node --test scripts/birthday-nft-test.mjs",
    "check:nft-mainnet": "node scripts/birthday-nft-mainnet-check.mjs",
    "build:birthday-artwork": "node scripts/build-birthday-demo.mjs --artwork",
    "creators": "tsx scripts/creator-review.ts"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "^2.26.0",
    "ethers": "6.17.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "ganache": "7.9.2",
    "ipfs-car": "3.1.0",
    "solc": "0.8.30",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
